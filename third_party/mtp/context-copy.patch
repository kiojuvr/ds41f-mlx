@@ -0,0 +1,121 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Singleton DSpark drafts from consumed target history, never pending anchors.
+
+Adapted from oMLX a2ee4a2c's context_copy (TensorFold suffix-lookup rule).
+This is derived, request-local metadata: the paired consumed frontier is the
+only authority. The pending anchor participates in the query, not the index.
+"""
+import sys
+import numpy as np
+
+ENABLED = True
+_BITS = 20
+_MATCH = 12
+_CAP = 64
+_CANDIDATES = 32
+
+
+def _key(a, b, c):
+    return (int(a) << (2 * _BITS)) | (int(b) << _BITS) | int(c)
+
+
+class ContextCopy:
+    def __init__(self, image_token_id=None):
+        self.ids = []
+        self.keys = np.empty(0, dtype=np.int64)
+        self.ends = np.empty(0, dtype=np.int64)
+        self.recent = {}
+        self.image_token_id = image_token_id
+        self.misses = self.quiet = 0
+
+    def _eligible(self, tokens):
+        return self.image_token_id is None or self.image_token_id not in tokens
+
+    def _build(self, history):
+        self.ids = list(history)
+        if len(history) < 3:
+            return
+        t = np.asarray(history, dtype=np.int64)
+        keys = (t[:-2] << (2 * _BITS)) | (t[1:-1] << _BITS) | t[2:]
+        ends = np.arange(2, len(t), dtype=np.int64)
+        if self.image_token_id is not None:
+            mask = (t[:-2] != self.image_token_id) & (t[1:-1] != self.image_token_id) & (t[2:] != self.image_token_id)
+            keys, ends = keys[mask], ends[mask]
+        order = np.argsort(keys, kind='stable')
+        self.keys, self.ends = keys[order], ends[order]
+
+    def sync(self, history, committed, frontier):
+        """Index only [0, frontier); committed[-1] is a query-only prediction.
+
+        Caller proves frontier = paired hist_offset + confirmed hidden rows,
+        after final acceptance/termination selection. A request's token history
+        is append-only; edits/branches acquire a fresh native state/index.
+        """
+        if frontier != len(history) + len(committed) - 1:
+            raise ValueError('copy frontier disagrees with settled target prefix')
+        if not self.ids:
+            self._build(history)
+        n = len(self.ids)
+        if n > len(history) or (n and self.ids[-1] != history[n - 1]):
+            raise ValueError('copy index outlived its consumed request prefix')
+        for token in [*history[n:], *committed[:-1]]:
+            self.ids.append(int(token))
+            end = len(self.ids) - 1
+            if end >= 2 and self._eligible(self.ids[end - 2:end + 1]):
+                self.recent.setdefault(_key(*self.ids[end - 2:end + 1]), []).append(end)
+        if len(self.ids) != frontier:
+            raise ValueError('copy index outran consumed frontier')
+
+    def propose(self, anchor, depth):
+        if self.quiet:
+            self.quiet -= 1
+            return []
+        query = self.ids[-(_CAP - 1):] + [int(anchor)]
+        if self.image_token_id in query:
+            query = query[len(query) - 1 - query[::-1].index(self.image_token_id) + 1:]
+        if depth < 1 or len(query) < _MATCH:
+            return []
+        key = _key(*query[-3:])
+        candidates = self.recent.get(key, ())[-_CANDIDATES:][::-1]
+        if len(candidates) < _CANDIDATES:
+            lo = int(np.searchsorted(self.keys, key, 'left'))
+            hi = int(np.searchsorted(self.keys, key, 'right'))
+            lo = max(lo, hi - (_CANDIDATES - len(candidates)))
+            candidates = list(candidates) + self.ends[lo:hi][::-1].tolist()
+        best_end, best_len = -1, 0
+        for end in candidates[:_CANDIDATES]:
+            # The complete source span, not just its matching suffix, must
+            # precede the consumed frontier. Never truncate into the anchor.
+            if end + 1 + depth > len(self.ids):
+                continue
+            length = 3
+            while length < min(len(query), end + 1, _CAP):
+                token = self.ids[end - length]
+                if token == self.image_token_id or token != query[-1 - length]:
+                    break
+                length += 1
+            if length > best_len:
+                copied = self.ids[end + 1:end + 1 + depth]
+                if not self._eligible(copied):
+                    continue
+                best_end, best_len = end, length
+                if length == _CAP:
+                    break
+        return self.ids[best_end + 1:best_end + 1 + depth] if best_len >= _MATCH else []
+
+    def observe(self, accepted):
+        self.misses = 0 if accepted else self.misses + 1
+        if self.misses >= 4:
+            self.misses, self.quiet = 0, 8
+
+    def resident_bytes(self):
+        """Host residency accounting for qualification, never in decode timing.
+
+        Includes even shared token int objects (a conservative attribution),
+        ndarray payloads/headers, dict keys, buckets and their end positions.
+        """
+        return (sys.getsizeof(self) + sys.getsizeof(self.__dict__) +
+                sys.getsizeof(self.ids) + sum(map(sys.getsizeof, self.ids)) +
+                sys.getsizeof(self.keys) + sys.getsizeof(self.ends) +
+                sys.getsizeof(self.recent) + sum(sys.getsizeof(k) + sys.getsizeof(v) +
+                sum(map(sys.getsizeof, v)) for k, v in self.recent.items()))
