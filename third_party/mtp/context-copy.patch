+def _context_copy_drafts(gen_batch, state, committed_ids):
+    """Singleton committed-source lookup; pending anchor is query-only."""
+    from . import context_copy
+    from .semantic_horizon import SemanticGuardError
+    host = _dspark_host(gen_batch.model)
+    if not context_copy.ENABLED or host is None or len(gen_batch.uids) != 1:
+        return []
+    if state.context_copy is None:
+        state.context_copy = context_copy.ContextCopy(getattr(host.args, 'image_token_id', None))
+    # Confirmed target taps describe the consumed prefix, including the old
+    # anchor, but NOT committed_ids[-1], the new unconsumed prediction.
+    frontier = state.hist_offset + len(committed_ids)
+    try:
+        state.context_copy.sync(gen_batch.tokens[0], committed_ids, frontier)
+    except ValueError as exc:
+        raise SemanticGuardError(str(exc)) from exc
+    depth = state.controller.cur if state.controller is not None else state.depth
+    # Replace only a full DSpark block with the SAME currently selected verify
+    # width. Native adaptive small blocks remain native; no shape policy change.
+    room = gen_batch.max_tokens[0] - gen_batch._num_tokens[0] - len(committed_ids) - 1
+    if depth != state.depth or room < depth:
+        return []
+    return state.context_copy.propose(committed_ids[-1], depth)
