+@@ -0,0 +1,39 @@
++"""All-deferred Messages use the existing V4.1 empty-schema encoding."""
++import deepseek_recipe as d
++
++
++def test_all_deferred_canonical_encoding():
++    tools = [d.ToolDefinition(name=n, parameters={'type': 'object'}, defer_loading=True)
++             for n in ('first', 'second')]
++    body = dict(model='DeepSeek-V4.1-Flash', thinking={'type': 'disabled'},
++                tools=[dict(name=t.name, input_schema={'type': 'object'}, defer_loading=True)
++                       for t in tools],
++                messages=[dict(role='user', content='before'),
++                          dict(role='system', content=[
++                              dict(type='tool_addition', tool=dict(type='tool_reference', name=n))
++                              for n in ('second', 'first')]),
++                          dict(role='user', content='after')])
++    converted = d.MessagesRequest(body).convert(d.ConversionOptions(default_thinking_mode=False))
++    # Independent semantic-conversation oracle: existing encoder, no converter.
++    expected = d.Conversation(thinking_mode=False, tools=tools, messages=[
++        d.UserMessage('before'), d.SystemMessage('', tools=[tools[1], tools[0]]),
++        d.UserMessage('after')])
++    encoding = d.DeepseekV41Encoding()
++    actual = encoding.render_conversation(converted.conversation).prompt
++    assert actual == encoding.render_conversation(expected).prompt
++    initial, update = actual.split('### Updated Tool Schemas')
++    assert '### Available Tool Schemas' in initial
++    assert '"name": "first"' not in initial and '"name": "second"' not in initial
++    assert update.index('"name": "second"') < update.index('"name": "first"')
++    assert [t.name for t in converted.conversation.tools] == ['first', 'second']
++
++
++def test_all_deferred_without_activation():
++    body = dict(model='DeepSeek-V4.1-Flash', thinking={'type': 'disabled'},
++                tools=[dict(name='later', input_schema={'type': 'object'}, defer_loading=True)],
++                messages=[dict(role='user', content='before')])
++    converted = d.MessagesRequest(body).convert(d.ConversionOptions(default_thinking_mode=False))
++    prompt = d.DeepseekV41Encoding().render_conversation(converted.conversation).prompt
++    assert '### Available Tool Schemas' in prompt
++    assert '"name": "later"' not in prompt
++    assert '### Updated Tool Schemas' not in prompt
