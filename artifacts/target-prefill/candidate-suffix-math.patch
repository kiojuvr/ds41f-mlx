+def _packed_suffix_attention(lang, mx, q, kv, pooled, idx, ci, sink, *, config, start, old_len, ratio):
+    """Reuse the admitted first-party target primitive on reviewed P6 geometry."""
+    c = config
+    # local_offset=localL-qL, not a hardcoded full old window. With 127
+    # prepared rows window_first(t)=t, matching the explicit local idx.
+    if (
+        getattr(lang, "__name__", "") == "ds41f_mlx.model_execution.language"
+        and q.shape[1] > 8
+        and c.n_heads == 64
+        and c.head_dim == 512
+        and c.window_size == 128
+        and old_len == 127
+        and q.dtype == mx.bfloat16
+        and lang.glm_fast.has_symbol("deepseek_v41_packed_attention")
+    ):
+        return lang.glm_fast.deepseek_v41_packed_attention(
+            q.transpose(0, 2, 1, 3), kv[:, None], pooled,
+            ci[:, None].astype(mx.uint32), sink,
+            c.head_dim**-0.5, start, max(ratio, 1), c.window_size,
+        ).transpose(0, 2, 1, 3)
+    return lang.packed_sparse_attention(q, kv, pooled, idx, ci, sink, c.head_dim**-0.5)
+
