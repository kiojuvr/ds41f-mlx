+    /// Fork synchronous semantic state at exactly push's next-input boundary.
+    /// No input submission, protocol generation or canonical mutation occurs.
+    fn preview_tokens(
+        &self,
+        py: Python<'_>,
+        candidate_ids: Vec<u32>,
+    ) -> PyResult<PySemanticPreview> {
+        self.with_state(py, |state| {
+            if state.closed || state.finished {
+                return Err(PyRuntimeError::new_err(
+                    "stream processor is closed or finished",
+                ));
+            }
+            state
+                .semantic
+                .preview_tokens(&candidate_ids)
+                .map(PySemanticPreview::from)
+                .map_err(|error| PyRuntimeError::new_err(error.to_string()))
+        })
+    }
+
+    /// First canonical semantic transition, including after normal completion.
+    /// This is independent of the protocol stream's finished property.
+    #[getter]
+    fn semantic_terminal(&self, py: Python<'_>) -> PyResult<Option<PySemanticTerminal>> {
+        self.with_state(py, |state| {
+            if state.closed {
+                return Err(PyRuntimeError::new_err("stream processor is closed"));
+            }
+            state
+                .semantic
+                .terminal()
+                .map(|value| value.map(PySemanticTerminal::from))
+                .map_err(|error| PyRuntimeError::new_err(error.to_string()))
+        })
+    }
