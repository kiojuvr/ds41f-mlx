diff --git a/deepseek-recipe/src/stream/semantic.rs b/deepseek-recipe/src/stream/semantic.rs
new file mode 100644
index 0000000..7dd7ae8
--- /dev/null
+++ b/deepseek-recipe/src/stream/semantic.rs
@@ -0,0 +1,205 @@
+//! Synchronous semantic state shared by canonical parsing and read-only preview.
+
+use std::sync::{Arc, Mutex};
+
+use super::StreamError;
+use super::decoder::{StreamDecoder, TokenizerDecoder};
+use super::state_machine::{OutputActionSegment, ParsingOptions, SemanticTerminal, StateMachine};
+
+/// Earliest terminal in candidate IDs. Count excludes its completing token.
+/// Source spans are absolute decoded-source bytes, not tokenization offsets.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct SemanticPreview {
+    pub terminal: Option<SemanticTerminal>,
+    pub completing_token_index: Option<usize>,
+    pub safe_token_count: usize,
+    pub mapping_exact: bool,
+    pub candidate_ids_processed: usize,
+    pub max_pending_ids: usize,
+}
+
+/// Contains only incremental parser/decoder state, never output history or a
+/// protocol generator. Clone copies pending IDs and KMP/stage state and shares
+/// the immutable decoding implementation.
+#[derive(Clone)]
+pub struct SemanticSession {
+    machine: StateMachine,
+    decoder: Option<StreamDecoder>,
+    ended: bool,
+}
+
+impl SemanticSession {
+    pub fn new(options: ParsingOptions) -> Self {
+        Self {
+            machine: StateMachine::new(options),
+            decoder: None,
+            ended: false,
+        }
+    }
+
+    pub fn with_tokenizer(mut self, decoder: impl TokenizerDecoder + 'static) -> Self {
+        self.decoder = Some(StreamDecoder::new(Box::new(decoder)));
+        self
+    }
+
+    #[cfg(test)]
+    pub(crate) fn test_fingerprint(&self) -> String {
+        format!(
+            "{:?}|{:?}|{}",
+            self.machine,
+            self.decoder.as_ref().map(|d| d.test_state()),
+            self.ended
+        )
+    }
+
+    pub fn terminal(&self) -> Option<&SemanticTerminal> {
+        self.machine.terminal()
+    }
+    pub fn source_bytes(&self) -> usize {
+        self.machine.source_bytes()
+    }
+    pub fn pending_ids(&self) -> &[u32] {
+        self.decoder
+            .as_ref()
+            .map(|d| d.pending_ids())
+            .unwrap_or(&[])
+    }
+
+    /// Decode and feed as one atomic synchronous step. The returned source and
+    /// actions are consumed by the existing canonical protocol stashing code.
+    pub fn token(
+        &mut self,
+        id: u32,
+    ) -> Result<Option<(String, usize, Vec<OutputActionSegment>)>, StreamError> {
+        if self.ended {
+            return Err(StreamError::Decode {
+                detail: "semantic input ended".into(),
+            });
+        }
+        let decoder = self.decoder.as_mut().ok_or(StreamError::MissingTokenizer)?;
+        let Some((content, tokens)) = decoder.decode(id)? else {
+            return Ok(None);
+        };
+        let actions = self.machine.feed(&content);
+        Ok(Some((content, tokens, actions)))
+    }
+
+    pub fn text(&mut self, content: &str) -> Result<Vec<OutputActionSegment>, StreamError> {
+        if self.ended {
+            return Err(StreamError::Decode {
+                detail: "semantic input ended".into(),
+            });
+        }
+        Ok(self.machine.feed(content))
+    }
+
+    pub fn finish(&mut self) -> Vec<OutputActionSegment> {
+        if self.ended {
+            return Vec::new();
+        }
+        self.ended = true;
+        // Original finish consumes the parser. Leave its last terminal/span
+        // accessible after normal stream completion, without a history replay.
+        self.machine.clone().finish()
+    }
+
+    pub fn preview_tokens(&self, ids: &[u32]) -> Result<SemanticPreview, StreamError> {
+        let decoder = self.decoder.as_ref().ok_or(StreamError::MissingTokenizer)?;
+        let mut result = SemanticPreview {
+            terminal: self.terminal().cloned(),
+            completing_token_index: None,
+            safe_token_count: 0,
+            mapping_exact: false,
+            candidate_ids_processed: 0,
+            max_pending_ids: decoder.pending_ids().len(),
+        };
+        // No meaningful candidate-relative map after canonical terminal/EOF.
+        if self.ended || self.terminal().is_some() || !decoder.supports_semantic_preview() {
+            return Ok(result);
+        }
+        let mut fork = self.clone();
+        result.mapping_exact = true;
+        for (index, id) in ids.iter().enumerate() {
+            result.max_pending_ids = result.max_pending_ids.max(fork.pending_ids().len() + 1);
+            fork.token(*id)?;
+            result.candidate_ids_processed += 1;
+            if let Some(terminal) = fork.terminal() {
+                result.terminal = Some(terminal.clone());
+                result.completing_token_index = Some(index);
+                result.safe_token_count = index;
+                return Ok(result);
+            }
+        }
+        result.safe_token_count = ids.len();
+        Ok(result)
+    }
+}
+
+/// A processor retains this handle before consuming itself into its async
+/// stream. Python serializes preview with push/drain at the next-input boundary.
+/// Rust callers must likewise invoke preview only at their canonical input
+/// boundary, not while another task is feeding input.
+#[derive(Clone)]
+pub struct SemanticSessionHandle(pub(crate) Arc<Mutex<SemanticSession>>);
+
+impl SemanticSessionHandle {
+    pub(crate) fn new(options: ParsingOptions) -> Self {
+        Self(Arc::new(Mutex::new(SemanticSession::new(options))))
+    }
+
+    pub(crate) fn set_tokenizer(&self, decoder: impl TokenizerDecoder + 'static) {
+        self.0.lock().expect("semantic lock poisoned").decoder =
+            Some(StreamDecoder::new(Box::new(decoder)));
+    }
+
+    pub(crate) fn token(
+        &self,
+        id: u32,
+    ) -> Result<Option<(String, usize, Vec<OutputActionSegment>)>, StreamError> {
+        self.0
+            .lock()
+            .map_err(|_| StreamError::Decode {
+                detail: "semantic lock poisoned".into(),
+            })?
+            .token(id)
+    }
+
+    pub(crate) fn text(&self, content: &str) -> Result<Vec<OutputActionSegment>, StreamError> {
+        self.0
+            .lock()
+            .map_err(|_| StreamError::Decode {
+                detail: "semantic lock poisoned".into(),
+            })?
+            .text(content)
+    }
+
+    pub(crate) fn finish(&self) -> Result<Vec<OutputActionSegment>, StreamError> {
+        Ok(self
+            .0
+            .lock()
+            .map_err(|_| StreamError::Decode {
+                detail: "semantic lock poisoned".into(),
+            })?
+            .finish())
+    }
+
+    pub fn preview_tokens(&self, ids: &[u32]) -> Result<SemanticPreview, StreamError> {
+        self.0
+            .lock()
+            .map_err(|_| StreamError::Decode {
+                detail: "semantic lock poisoned".into(),
+            })?
+            .preview_tokens(ids)
+    }
+
+    pub fn terminal(&self) -> Result<Option<SemanticTerminal>, StreamError> {
+        Ok(self
+            .0
+            .lock()
+            .map_err(|_| StreamError::Decode {
+                detail: "semantic lock poisoned".into(),
+            })?
+            .terminal()
+            .cloned())
+    }
+}
diff --git a/deepseek-recipe/src/stream/semantic_tests.rs b/deepseek-recipe/src/stream/semantic_tests.rs
new file mode 100644
index 0000000..00a1124
--- /dev/null
+++ b/deepseek-recipe/src/stream/semantic_tests.rs
@@ -0,0 +1,262 @@
+use super::semantic::SemanticSession;
+use super::state_machine::{ParsingOptions, ReasoningStage, SemanticTerminalKind};
+use super::{
+    ChunkGenerator, InferenceChunk, InferenceFinishReason, OutputChunk, StreamProcessor,
+    TokenizerDecoder,
+};
+use std::sync::Arc;
+use tokenizers::Tokenizer;
+use tokio_stream::StreamExt;
+
+fn tokenizer() -> Arc<Tokenizer> {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .parent()
+        .unwrap()
+        .join("static/tokenizers/v41/tokenizer.json");
+    Arc::new(Tokenizer::from_file(path).unwrap())
+}
+
+fn ids(t: &Tokenizer, text: &str) -> Vec<u32> {
+    t.encode(text, false).unwrap().get_ids().to_vec()
+}
+
+fn options(stops: &[&str]) -> ParsingOptions {
+    ParsingOptions {
+        stop_sequences: stops.iter().map(|s| s.to_string()).collect(),
+        ..Default::default()
+    }
+}
+
+fn feed(session: &mut SemanticSession, tokens: &[u32]) {
+    for id in tokens {
+        session.token(*id).unwrap();
+    }
+}
+
+const CALL: &str = "<｜DSML｜ calls>\n<｜DSML｜ invoke name=\"lookup\">\n<｜DSML｜ parameter name=\"city\" string=\"true\">Paris</｜DSML｜ parameter>\n</｜DSML｜ invoke>\n</｜DSML｜ calls>";
+
+#[test]
+fn every_dsml_token_split_is_an_exact_nonmutating_preview() {
+    let t = tokenizer();
+    let tokens = ids(&t, CALL);
+    for split in 0..tokens.len() {
+        let mut canonical = SemanticSession::new(options(&[])).with_tokenizer(t.clone());
+        feed(&mut canonical, &tokens[..split]);
+        assert!(canonical.terminal().is_none());
+        let before = canonical.test_fingerprint();
+        let result = canonical.preview_tokens(&tokens[split..]).unwrap();
+        assert_eq!(before, canonical.test_fingerprint());
+        assert_eq!(result, canonical.preview_tokens(&tokens[split..]).unwrap());
+        assert!(result.mapping_exact);
+        assert_eq!(
+            result.completing_token_index,
+            Some(tokens.len() - split - 1)
+        );
+        assert_eq!(result.safe_token_count, tokens.len() - split - 1);
+        let terminal = result.terminal.unwrap();
+        assert_eq!(terminal.kind, SemanticTerminalKind::DsmlToolCallBlockEnd);
+        assert_eq!(
+            &CALL.as_bytes()[terminal.source_start..terminal.source_end],
+            "</｜DSML｜ calls>".as_bytes()
+        );
+        feed(&mut canonical, &tokens[split..]);
+        assert_eq!(canonical.terminal(), Some(&terminal));
+    }
+}
+
+#[test]
+fn pending_canonical_utf8_ids_and_candidate_group() {
+    let t = tokenizer();
+    let tokens = ids(&t, "🙂");
+    assert!(tokens.len() > 1);
+    let mut canonical = SemanticSession::new(options(&["🙂"])).with_tokenizer(t);
+    feed(&mut canonical, &tokens[..1]);
+    assert_eq!(canonical.source_bytes(), 0);
+    assert_eq!(canonical.pending_ids(), &tokens[..1]);
+    let before = canonical.test_fingerprint();
+    let p = canonical.preview_tokens(&tokens[1..]).unwrap();
+    assert_eq!(p.completing_token_index, Some(tokens.len() - 2));
+    assert_eq!(p.safe_token_count, tokens.len() - 2);
+    assert_eq!(p.max_pending_ids, tokens.len());
+    assert_eq!(p.terminal.unwrap().source_end, "🙂".len());
+    assert_eq!(before, canonical.test_fingerprint());
+}
+
+#[test]
+fn stops_across_every_token_boundary_with_shared_prefix_and_unicode() {
+    let t = tokenizer();
+    let text = "café🙂HALT NOT yet HALT NOW";
+    let tokens = ids(&t, text);
+    for split in 0..tokens.len() {
+        let mut canonical =
+            SemanticSession::new(options(&["HALT NOW", "HALT NEVER"])).with_tokenizer(t.clone());
+        feed(&mut canonical, &tokens[..split]);
+        let p = canonical.preview_tokens(&tokens[split..]).unwrap();
+        let terminal = p.terminal.unwrap();
+        assert!(p.mapping_exact);
+        assert_eq!(p.completing_token_index, Some(tokens.len() - split - 1));
+        assert_eq!(terminal.kind, SemanticTerminalKind::StopSequence);
+        assert_eq!(terminal.source_start, text.len() - "HALT NOW".len());
+        assert_eq!(terminal.source_end, text.len());
+    }
+}
+
+#[test]
+fn simulated_rejection_and_partial_emission_never_repair_parser() {
+    let t = tokenizer();
+    let tokens = ids(&t, CALL);
+    for emitted in [0, 1, tokens.len() / 2, tokens.len() - 1, tokens.len()] {
+        let mut canonical = SemanticSession::new(options(&[])).with_tokenizer(t.clone());
+        let mut reference = canonical.clone();
+        let before = canonical.test_fingerprint();
+        canonical.preview_tokens(&tokens).unwrap();
+        assert_eq!(before, canonical.test_fingerprint());
+        feed(&mut canonical, &tokens[..emitted]);
+        feed(&mut reference, &tokens[..emitted]);
+        assert_eq!(canonical.test_fingerprint(), reference.test_fingerprint());
+    }
+}
+
+#[test]
+fn opening_invocation_close_and_json_fence_are_not_terminal() {
+    let t = tokenizer();
+    for text in [
+        "<｜DSML｜ calls>",
+        &CALL[..CALL.rfind("</｜DSML｜ calls>").unwrap()],
+    ] {
+        let session = SemanticSession::new(options(&[])).with_tokenizer(t.clone());
+        assert!(
+            session
+                .preview_tokens(&ids(&t, text))
+                .unwrap()
+                .terminal
+                .is_none()
+        );
+    }
+    let mut json_options = options(&[]);
+    json_options.parse_json_output = true;
+    let session = SemanticSession::new(json_options).with_tokenizer(t.clone());
+    assert!(
+        session
+            .preview_tokens(&ids(&t, "```json\n{}\n``` tail"))
+            .unwrap()
+            .terminal
+            .is_none()
+    );
+}
+
+#[test]
+fn reasoning_excludes_user_stops_until_content() {
+    let t = tokenizer();
+    let mut o = options(&["STOP"]);
+    o.reasoning_initial_stage = Some(ReasoningStage::Reasoning);
+    let mut session = SemanticSession::new(o).with_tokenizer(t.clone());
+    let reasoning = ids(&t, "STOP thoughts");
+    assert!(
+        session
+            .preview_tokens(&reasoning)
+            .unwrap()
+            .terminal
+            .is_none()
+    );
+    feed(&mut session, &reasoning);
+    assert!(
+        session
+            .preview_tokens(&ids(&t, "</think>STOP"))
+            .unwrap()
+            .terminal
+            .is_some()
+    );
+}
+
+#[test]
+fn terminal_tail_earliest_span_and_ended_input_fail_closed() {
+    let t = tokenizer();
+    let mut session = SemanticSession::new(options(&[])).with_tokenizer(t.clone());
+    let p = session
+        .preview_tokens(&ids(&t, &(CALL.to_string() + "TAIL")))
+        .unwrap();
+    assert_eq!(p.terminal.as_ref().unwrap().source_end, CALL.len());
+    feed(&mut session, &ids(&t, CALL));
+    let p = session.preview_tokens(&ids(&t, "TAIL")).unwrap();
+    assert!(!p.mapping_exact);
+    assert_eq!(p.safe_token_count, 0);
+    session.finish();
+    assert!(!session.preview_tokens(&[]).unwrap().mapping_exact);
+    assert!(session.token(1).is_err());
+}
+
+struct UnsupportedDecoder;
+impl TokenizerDecoder for UnsupportedDecoder {
+    fn decode_ids(&self, _: &[u32], _: bool) -> Result<String, String> {
+        panic!("must not preview untrusted decoder")
+    }
+}
+
+#[test]
+fn custom_decoder_does_not_implicitly_claim_exactness() {
+    let session = SemanticSession::new(options(&[])).with_tokenizer(UnsupportedDecoder);
+    let p = session.preview_tokens(&[1, 2]).unwrap();
+    assert!(!p.mapping_exact);
+    assert_eq!(p.safe_token_count, 0);
+    assert_eq!(p.candidate_ids_processed, 0);
+}
+
+struct FailingDecoder;
+impl TokenizerDecoder for FailingDecoder {
+    fn supports_semantic_preview(&self) -> bool {
+        true
+    }
+    fn decode_ids(&self, _: &[u32], skip: bool) -> Result<String, String> {
+        assert!(!skip);
+        Err("test error".into())
+    }
+}
+
+#[test]
+fn decode_error_leaves_canonical_state_unchanged() {
+    let session = SemanticSession::new(options(&[])).with_tokenizer(FailingDecoder);
+    let before = session.test_fingerprint();
+    assert!(session.preview_tokens(&[1]).is_err());
+    assert_eq!(before, session.test_fingerprint());
+}
+
+struct Echo;
+impl ChunkGenerator for Echo {
+    type Chunk = OutputChunk;
+    async fn generate(&mut self, chunk: OutputChunk) -> Vec<OutputChunk> {
+        vec![chunk]
+    }
+}
+
+#[tokio::test]
+async fn canonical_processor_uses_retained_session_but_keeps_finish_behavior() {
+    let t = tokenizer();
+    let processor = StreamProcessor::new(Echo, options(&[])).with_tokenizer(t.clone());
+    let handle = processor.semantic_session();
+    let p = handle.preview_tokens(&ids(&t, CALL)).unwrap();
+    assert!(p.mapping_exact);
+    assert!(handle.terminal().unwrap().is_none());
+    let mut input = ids(&t, CALL)
+        .into_iter()
+        .map(|id| InferenceChunk::Token { token_id: id })
+        .collect::<Vec<_>>();
+    input.push(InferenceChunk::Finish {
+        finish_reason: InferenceFinishReason::Stop,
+    });
+    let stream = processor.process(tokio_stream::iter(input));
+    tokio::pin!(stream);
+    let mut chunks = Vec::new();
+    while let Some(chunk) = stream.next().await {
+        chunks.push(chunk.unwrap());
+    }
+    assert_eq!(handle.terminal().unwrap(), p.terminal);
+    assert!(matches!(
+        chunks.last(),
+        Some(OutputChunk::Finish {
+            reason: super::FinishReason::ToolCalls,
+            ..
+        })
+    ));
+    assert!(!handle.preview_tokens(&[]).unwrap().mapping_exact);
+}
