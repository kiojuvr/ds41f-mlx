+/// Snapshot of the actual consuming parser, decoder, stashing and protocol generator.
+/// It is refreshed only at the canonical next-input boundary, never by replay.
+pub struct CanonicalPreviewHandle<G>(Arc<Mutex<Option<CanonicalSnapshot<G>>>>);
+impl<G> Clone for CanonicalPreviewHandle<G> {
+    fn clone(&self) -> Self { Self(self.0.clone()) }
+}
+#[derive(Clone)]
+struct CanonicalSnapshot<G> {
+    semantic: SemanticSession,
+    stashed: StashedChunks,
+    generator: G,
+    completion_usage: CompletionUsage,
+}
+impl<G: ChunkGenerator + Clone> CanonicalPreviewHandle<G> {
+    /// Each row contains consuming token events and its cloned Stop/EOF events.
+    /// EOF forks do not advance the next candidate or the canonical generator.
+    pub async fn preview_tokens_eof(&self, ids: &[u32]) -> Result<Vec<(Vec<G::Chunk>, Vec<G::Chunk>)>, StreamError> {
+        let mut fork = self.0.lock().map_err(|_| StreamError::Decode { detail: "preview lock poisoned".into() })?
+            .as_ref().ok_or(StreamError::Decode { detail: "no canonical input boundary".into() })?.clone();
+        let mut rows = Vec::new();
+        for id in ids.iter().map(Some).chain(if ids.is_empty() { Some(None) } else { None }) {
+            let mut chunks = Vec::new();
+            if let Some((content, tokens, actions)) = match id { Some(id) => fork.semantic.token(*id)?, None => None } {
+                fork.completion_usage.completion_tokens += tokens;
+                fork.stashed.push(Some(content));
+                chunks = fork.stashed.apply_actions(actions, &mut fork.generator).await;
+            }
+            let mut eof = fork.clone();
+            let actions = eof.semantic.finish();
+            let mut finish = eof.stashed.apply_actions(actions, &mut eof.generator).await;
+            let stop_sequence = eof.stashed.take_stop_sequence();
+            let reason = canonical_finish_reason(Some(InferenceFinishReason::Stop), eof.stashed.has_tool_calls, stop_sequence.is_some());
+            finish.extend(eof.generator.generate(OutputChunk::Finish {
+                reason, stop_sequence, usage: eof.completion_usage,
+            }).await);
+            rows.push((chunks, finish));
+            if fork.semantic.terminal().is_some() { break; }
+        }
+        Ok(rows)
+    }
+}
+
+fn canonical_finish_reason(backend: Option<InferenceFinishReason>, has_tool_calls: bool, stopped: bool) -> FinishReason {
+    if stopped { return FinishReason::StopSequence; }
+    match backend {
+        Some(InferenceFinishReason::Stop) if has_tool_calls => FinishReason::ToolCalls,
+        Some(InferenceFinishReason::Stop) => FinishReason::Stop,
+        Some(InferenceFinishReason::Length) => FinishReason::Length,
+        Some(InferenceFinishReason::ContentFilter) => FinishReason::ContentFilter,
+        None => FinishReason::EndOfStream,
+    }
+}
+
 fn non_empty(content: Option<String>) -> Option<String> {
     content.filter(|content| !content.is_empty())
 }
