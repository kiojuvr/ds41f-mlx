    "layer_axis_indexed_by": "layer.engram.layer_hash_index",
    "selection_expression": "engram_hashes[:, :, layer.engram.layer_hash_index, :]",
    "selection_meaning": "selects all batch/sequence rows and all hash columns for the Engram table corresponding to the current layer id"
