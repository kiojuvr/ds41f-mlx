  "ngram_hash_state_contract": {
    "constructor_inputs": [
      "args",
      "layout: EngramLayout",
      "tokenizer"
    ],
    "persistent_state_fields": [
      "primes buffer persistent=False shape [num_layers,max_ngram_size-1,n_heads]",
      "offsets buffer persistent=False shape [num_layers,n_hash_cols]",
      "multipliers buffer persistent=False shape [num_layers,max_ngram_size]",
      "token_map buffer persistent=False shape [len(tokenizer)]",
      "cache buffer persistent=False shape [max_batch_size,max_seq_len] dtype int64"
    ],
    "tokenizer_derived_state": "build_compressed_token_map(tokenizer) creates token_id -> compressed_id lookup and compressed vocab size; assert equals args.engram_compressed_vocab_size",
    "DEAD": -1,
    "pad_id_source": "self.pad_id = token_map[args.engram_pad_id]",
    "ngram_orders": "shift loop 0..max_ngram_size-1 collects current token plus history; returned hashes correspond to rolling steps i=1..max_ngram_size-1, i.e. 2-gram..max_ngram_size-gram",
    "hash_coefficients": {
      "shape": [
        2,
        4
      ],
      "dtype": "torch.int64",
      "algorithm": "compute_hash_multipliers(layer_ids, max_ngram_size, tokenizer_compressed_vocab_size); np.random.default_rng(10007 * layer_id); integers low=0 high=multiplier_bound; value*2+1",
      "multiplier_bound": 46539438283891,
      "values": [
        [
          76632096046245,
          4839876093313,
          35959672319349,
          73987337458391
        ],
        [
          67716810739261,
          51510806800915,
          30921347202721,
          82619226485591
        ]
      ]
    },
    "modulus_and_table_rules": "rolling XOR hash modulo primes[:, i-1], then add per-layer flattened offsets",
    "token_id_transformation": "input_ids -> token_map[input_ids] -> compressed ids; not raw token ids",
    "special_token_treatment": "no BOS/EOS special branch; all ids are decoded/normalized into compressed token map; missing/blocked history uses compressed pad id from engram_pad_id=2",
    "image_mask_interaction": "token_mask False positions are stored as DEAD and cause current and later lookback positions crossing them to use pad_id; Transformer passes engram_mask where False means image token/no ngram participation",
    "start_pos_semantics": "writes compressed tokens to cache[:batch, start_pos:start_pos+seqlen]; positions arange(start_pos,start_pos+seqlen); history gathered from cache with clamped positions and blocked when positions < shift",
    "prefill_semantics_start_pos0": "for shift greater than available history, positions < shift blocks and uses pad_id; cache is populated before gather",
    "decode_incremental_semantics": "same cache carries prior calls; not numerically validated here",
    "state_update_order": [
      "compress token ids",
      "apply token_mask False -> DEAD",
      "write cache slice",
      "build positions",
      "gather current/history shifts from cache",
      "update blocked cumulatively",
      "replace blocked sources with pad_id",
      "stack tokens [B,L,max_ngram_size]",
      "products=tokens.unsqueeze(2)*multipliers",
      "rolling XOR and modulo per ngram order",
      "torch.cat hashes along last axis and add offsets"
    ],
    "returned_tensor": {
      "expression": "torch.cat(hashes, dim=-1) + self.offsets",
      "shape": "[B,L,num_engram_layers,(max_ngram_size-1)*n_heads]",
      "released_shape_for_B1_S2": "[1,2,2,24]",
      "dtype": "torch int64 from int64 token map/cache/multipliers/primes/offsets",
      "axis_order": [
        "batch",
        "sequence",
        "engram layer in layout.layer_ids order",
        "hash columns ordered by ngram order then head"
      ]
    }
  },
  "transformer_to_ngram_hash_state_interface": {
    "call": "self.engram_hash(input_ids, start_pos, engram_mask)",
    "input_ids": "torch.Tensor shape [B,S], integer token ids; Transformer doc says every entry real token id",
