  "parallel_engram_embedding_contract": {
    "input": "indices tensor of hash ids, expected selected layer shape [B,S,n_hash_cols] in Engram.forward",
    "partition": "part_num_embeddings=ceil(num_embeddings/world_size); vocab_start_idx=rank*part_num_embeddings; vocab_end_idx=vocab_start_idx+part_num_embeddings",
    "out_of_range_handling": "mask indices outside local partition; local_indices masked to 0; output values masked to zero before all_reduce",
    "lookup": "F.embedding local_indices into fp8 weight and scale",
    "dequantization_order": "values.float().unflatten(-1,(-1,32)) * scales.float().unsqueeze(-1); flatten; to bfloat16; masked_fill; all_reduce if world_size>1",
    "output_shape": "input indices shape plus final dim layout.head_dim, so [B,S,n_hash_cols,engram_head_dim]",
    "output_dtype": "torch.bfloat16",
    "world_size1_path": "rank=0, part_num_embeddings=num_embeddings, no all_reduce; all valid hash ids within table are local"
  },
  "engram_forward_contract": {
    "inputs": {
      "x": "[B,L,hc_mult,dim]",
      "hash_ids": "[B,L,n_hash_cols]",
      "token_mask": "None or [B,L] bool, False shuts gate"
    },
    "source_order": [
      "embed(hash_ids) -> [B,L,n_hash_cols,head_dim] bf16",
      "flatten(-2) -> [B,L,n_hash_cols*head_dim]",
      "wkv Linear -> [B,L,dim*(hc_mult+1)]",
      "split key [B,L,hc_mult*dim], value [B,L,dim]",
      "key.float().unflatten(-1,(hc_mult,dim))",
      "weight=q_weight.float()*k_weight.float()",
      "h=x.float()",
      "rstd=rsqrt(mean(h^2,-1)+eps)*rsqrt(mean(key^2,-1)+eps)",
      "dot=(h*weight*key).sum(-1)*rstd*dim**-0.5",
      "gate=sigmoid(copysign(clamp_min(abs(dot),1e-6).sqrt(),dot))",
      "if token_mask not None: gate masked False to 0",
      "return (h + gate.unsqueeze(-1)*value.float().unsqueeze(-2)).to(x.dtype)"
    ],
    "broadcasting": "value [B,L,D] broadcasts across HC axis via unsqueeze(-2); gate [B,L,HC] controls each HC copy",
    "output_shape": "same as x [B,L,hc_mult,dim]",
    "output_dtype": "x.dtype"
  },
