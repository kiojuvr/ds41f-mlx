diff --git a/omlx/patches/mlx_lm_mtp/semantic_horizon.py b/omlx/patches/mlx_lm_mtp/semantic_horizon.py
new file mode 100644
index 00000000..c7ea59b7
--- /dev/null
+++ b/omlx/patches/mlx_lm_mtp/semantic_horizon.py
@@ -0,0 +1,110 @@
+"""Optional session-owned singleton semantic horizon; contains no grammar.
+
+Errors deliberately are not _MtpStepFallback: guarded requests may never enter
+upstream's history-rebuilding reconciliation path on a semantic failure.
+"""
+from dataclasses import dataclass
+from collections import deque
+
+
+class SemanticGuardError(RuntimeError):
+    pass
+
+
+@dataclass(frozen=True)
+class Prediction:
+    kind: str
+    index: int
+    safe_count: int
+    token_id: int
+    identity: object
+
+
+@dataclass(frozen=True)
+class OwnedTerminal:
+    ordinal: int
+    prediction: Prediction
+    region: str
+    candidate_ids: tuple[int, ...]
+    queued_prefix: int
+    owner_uid: object
+
+
+class SemanticHorizon:
+    def __init__(self, guard):
+        self.guard = guard
+        self.owner_uid = None
+        self.pending = None
+        self.completed = False
+        self.last_state = None
+        self.last_cache = None
+        self.decisions = deque(maxlen=16)
+
+    def preview(self, gen_batch, candidate_ids, *, region, queue=()):
+        if self.owner_uid is None:
+            self.owner_uid = gen_batch.uids[0]
+        if self.owner_uid != gen_batch.uids[0]:
+            raise SemanticGuardError('semantic prediction belongs to a different generation UID')
+        if self.completed or self.pending is not None:
+            raise SemanticGuardError('semantic horizon forbids another candidate cycle')
+        queued = [int(entry[0]) for entry in queue]
+        candidates = list(map(int, candidate_ids))
+        ids = queued + candidates
+        result = self.guard.preview(ids)
+        if result is None:
+            return None
+        if not isinstance(result, Prediction):
+            raise SemanticGuardError('guard returned invalid prediction type')
+        if not (0 <= result.index < len(ids)) or result.safe_count != result.index or ids[result.index] != result.token_id:
+            raise SemanticGuardError('guard returned inexact candidate provenance')
+        if result.index < len(queued):
+            # Such a terminal was already target-committed: do not hide it by
+            # treating only the new region as safe or advancing canonical state.
+            raise SemanticGuardError('semantic terminal inside committed queued prefix')
+        self.decisions.append(OwnedTerminal(int(gen_batch._num_tokens[0]) + result.index,
+                                            result, region, tuple(ids), len(queued), self.owner_uid))
+        return self.decisions[-1]
+
+    def bind(self, terminal):
+        if self.pending is not None or self.completed:
+            raise SemanticGuardError('duplicate terminal ownership')
+        self.pending = terminal
+
+    def observe(self, gen_batch, token_id):
+        if self.owner_uid is not None and self.owner_uid != gen_batch.uids[0]:
+            raise SemanticGuardError('canonical emission owner differs from prediction UID')
+        if self.completed:
+            raise SemanticGuardError('canonical emission after semantic terminal')
+        ordinal = int(gen_batch._num_tokens[0])
+        expected = None
+        if self.pending is not None:
+            if ordinal > self.pending.ordinal:
+                raise SemanticGuardError('terminal response ordinal skipped')
+            if ordinal == self.pending.ordinal:
+                if int(token_id) != self.pending.prediction.token_id:
+                    raise SemanticGuardError('terminal token differs from owned response')
+                expected = self.pending.prediction.identity
+        reason = self.guard.observe_canonical_emit(int(token_id), expected)
+        if (reason is not None) != (expected is not None):
+            raise SemanticGuardError('unexpected or missing canonical terminal')
+        if reason is not None:
+            if reason != 'stop':
+                raise SemanticGuardError('guard must supply backend stop for protocol completion')
+            self.completed = True
+            self.pending = None
+        return reason
+
+
+def horizon(gen_batch):
+    guard = getattr(gen_batch, '_omlx_semantic_guard', None)
+    if guard is None:
+        return None
+    if len(gen_batch.uids) != 1:
+        raise SemanticGuardError('semantic guard is singleton-only')
+    current = getattr(gen_batch, '_omlx_semantic_horizon', None)
+    if current is None:
+        current = SemanticHorizon(guard)
+        gen_batch._omlx_semantic_horizon = current
+    elif current.guard is not guard:
+        raise SemanticGuardError('semantic guard owner changed')
+    return current
