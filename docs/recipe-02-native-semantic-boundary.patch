+++ b/deepseek-recipe-python/tests/test_messages_semantic_session.py
@@ -0,0 +1,226 @@
+"""Native Messages boundary, not HTTP/application execution authority."""
+import gc
+import json
+import re
+
+import pytest
+import deepseek_recipe as d
+import test_semantic_session as shared
+from test_semantic_session import PATH, PREFIX, END, encode, row_value
+
+
+def setup(stop_sequences=None, thinking=False, signature=None):
+    tok = d.Tokenizer.from_file(str(PATH))
+    converted = d.MessagesRequest({
+        'model': 'DeepSeek-V4.1-Flash', 'max_tokens': 256,
+        'messages': [{'role': 'user', 'content': 'hi'}],
+        'thinking': {'type': 'enabled' if thinking else 'disabled'},
+        'tools': [{'name': 'f', 'input_schema': {'type': 'object'}},
+                  {'name': 'g', 'input_schema': {'type': 'object'}}],
+    }).convert(d.ConversionOptions())
+    def generator():
+        g = d.MessagesRequest.chunk_generator(converted, 'response', 'model')
+        return g if signature is None else g.with_signature(signature)
+    options = converted.parsing_options
+    if stop_sequences is not None:
+        options.stop_sequences = stop_sequences
+    return tok, converted, generator, d.MessagesSemanticSession(generator(), options, tok)
+
+
+def response():
+    return d.MessagesResponse('response', 'model', 0, 0, 0)
+
+
+def apply(resp, chunks):
+    for chunk in chunks:
+        before = chunk.to_json()
+        resp.accumulate_copy(chunk)
+        assert chunk.to_json() == before
+
+
+@pytest.mark.parametrize('thinking,reasoning,signature', [
+    (False, '', None), (True, '', None), (True, 'inspect carefully', 'opaque-signature'),
+])
+def test_exact_events_ids_and_official_accumulation(thinking, reasoning, signature):
+    tok, converted, generator, session = setup(thinking=thinking, signature=signature)
+    text = ((reasoning + '</think>') if thinking else '') + 'intro ' + PREFIX + 'Tokyo🤭' + END
+    text += '<｜DSML｜invoke name="g"></｜DSML｜invoke></｜DSML｜tool_calls>'
+    ids = encode(tok, text)
+    ready = d.InferenceChunk.ready(prompt_usage=d.PromptUsage(prompt_tokens=20, prompt_cache_hit_tokens=7))
+    apply_response = response()
+    start = session.push(ready)
+    start_events = [json.loads(c.to_json()) for c in start[2]]
+    assert start_events[0]['type'] == 'message_start'
+    apply(apply_response, start[2])
+    before = session.status
+    projected = session.preview_tokens(ids)
+    rejected = session.preview_tokens(encode(tok, (('</think>') if thinking else '') +
+        '<｜DSML｜tool_calls><｜DSML｜invoke name="rejected"></｜DSML｜invoke>'))
+    assert any(r[3] for r in rejected[3])
+    assert [row_value(r) for r in projected[3]] == [row_value(r) for r in session.preview_tokens(ids)[3]]
+    assert session.status == before
+    predicted = apply_response.fork()
+    calls, events = [], []
+    partial_fork = None
+    for n, token in enumerate(ids):
+        one = session.preview_tokens([token])
+        actual = session.push(d.InferenceChunk.tokens([token]))
+        assert row_value(actual) == row_value(one[3][0]) == row_value(projected[3][n])
+        calls.extend(actual[3])
+        events.extend(json.loads(c.to_json()) for c in actual[2])
+        apply(apply_response, actual[2])
+        apply(predicted, projected[3][n][2])
+        assert apply_response.to_json() == predicted.to_json()
+        # Fork while the official accumulator has unparsed JSON fragments.
+        if partial_fork is None and any(e.get('delta', {}).get('type') == 'input_json_delta'
+                                        for e in events):
+            partial_fork = apply_response.fork()
+        elif partial_fork is not None:
+            apply(partial_fork, actual[2])
+            assert partial_fork.to_json() == apply_response.to_json()
+    assert len(calls) == 2
+    assert calls[0] == (0, len((text[:text.index(END)] + END[:-len('invoke>')]).encode()))
+    assert not any(r[5] for r in projected[3][:-1]) and projected[3][-1][5]
+    assert all(not r[4] for r in projected[3])
+    stop = d.InferenceChunk.finish(d.InferenceFinishReason.Stop)
+    p = session.preview_tokens([], finish=stop)[3][0]
+    a = session.push(stop)
+    assert row_value(p) == row_value(a)
+    assert a[4] and not a[5]  # live parser released at Finish, not a sticky bit
+    events.extend(json.loads(c.to_json()) for c in a[2])
+    apply(apply_response, a[2])
+    apply(partial_fork, a[2])
+    assert partial_fork.to_json() == apply_response.to_json()
+    body = json.loads(apply_response.to_json())
+    tools = [c for c in body['content'] if c['type'] == 'tool_use']
+    assert [c['input'] for c in tools] == [{'x': 'Tokyo🤭'}, {}]
+    et = 'ET_' if thinking and not reasoning else ''
+    for index, tool in enumerate(tools):
+        assert re.fullmatch(rf'call_{index:02}_{et}[A-Za-z0-9]{{20}}[0-9]{{4}}', tool['id'])
+    assert tools[0]['id'] != tools[1]['id']
+    assert body['stop_reason'] == 'tool_use'
+    assert body['usage']['input_tokens'] == 13
+    assert body['usage']['cache_read_input_tokens'] == 7
+    assert body['usage']['output_tokens'] == len(ids)
+    assert events[-1]['type'] == 'message_stop'
+    assert any(e['type'] == 'content_block_stop' for e in events)
+    if thinking:
+        block = body['content'][0]
+        assert block == {'type': 'thinking', 'thinking': reasoning,
+                         'signature': signature or 'response'}
+        assert any(e.get('delta', {}).get('type') == 'signature_delta' for e in events)
+    # Standard upstream processor has independent randomness. Only independent
+    # tool IDs differ; no event structure, usage, signature or metadata is removed.
+    ordinary = d.StreamProcessor(generator(), converted.parsing_options, tok)
+    official = response()
+    ordinary_events = ordinary.push(ready)
+    # Include message_start separately, already canonically consumed above.
+    all_actual = start_events + events
+    for token in ids:
+        ordinary_events += ordinary.push(d.InferenceChunk.tokens([token]))
+    ordinary_events += ordinary.push(stop)
+    for c in ordinary_events:
+        official.accumulate_copy(c)
+    expected_events = [json.loads(c.to_json()) for c in ordinary_events]
+    def independent_ids(value):
+        if isinstance(value, dict):
+            return {k: ('INDEPENDENT_ID' if k == 'id' and value.get('type') == 'tool_use'
+                        else independent_ids(v)) for k, v in value.items()}
+        if isinstance(value, list):
+            return [independent_ids(v) for v in value]
+        return value
+    assert independent_ids(all_actual) == independent_ids(expected_events)
+    assert independent_ids(body) == independent_ids(json.loads(official.to_json()))
+    ordinary.close()
+    session.close()
+
+    # Feed official output straight back through official Messages conversion.
+    # ET_ is continuation metadata, not cosmetic identity normalization.
+    continuation = {
+        'model': 'DeepSeek-V4.1-Flash', 'max_tokens': 256,
+        'thinking': {'type': 'enabled' if thinking else 'disabled'},
+        'tools': [{'name': 'f', 'input_schema': {'type': 'object'}},
+                  {'name': 'g', 'input_schema': {'type': 'object'}}],
+        'messages': [
+            {'role': 'user', 'content': 'hi'},
+            {'role': 'assistant', 'content': body['content']},
+            {'role': 'user', 'content': [
+                {'type': 'tool_result', 'tool_use_id': t['id'], 'content': 'ok'}
+                for t in tools]},
+        ],
+    }
