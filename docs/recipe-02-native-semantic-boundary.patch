+++ b/deepseek-recipe-python/tests/test_semantic_session.py
@@ -0,0 +1,183 @@
+"""Focused Python/native boundary proof; no Runtime/guard substitution."""
+import gc
+import json
+import re
+from pathlib import Path
+
+import pytest
+import deepseek_recipe as d
+
+PATH = Path(__file__).resolve().parents[2] / 'static/tokenizers/v41/tokenizer.json'
+PREFIX = '<｜DSML｜tool_calls><｜DSML｜invoke name="f"><｜DSML｜parameter name="x" string="true">'
+END = '</｜DSML｜parameter></｜DSML｜invoke>'
+
+
+def setup(stop_sequences=None):
+    tok = d.Tokenizer.from_file(str(PATH))
+    converted = d.ChatCompletionRequest({
+        'model': 'DeepSeek-V4.1-Flash', 'messages': [{'role': 'user', 'content': 'hi'}],
+        'thinking': {'type': 'disabled'},
+        'tools': [{'type': 'function', 'function': {'name': 'f'}},
+                  {'type': 'function', 'function': {'name': 'g'}}],
+    }).convert(d.ConversionOptions())
+    def generator():
+        return d.ChatCompletionRequest.chunk_generator(converted, 'response', 'model')
+    options = converted.parsing_options
+    if stop_sequences is not None:
+        options.stop_sequences = stop_sequences
+    session = d.ChatCompletionSemanticSession(generator(), options, tok)
+    return tok, converted, generator, session
+
+
+def encode(tok, text):
+    # Encode added vocabulary units explicitly, including the DSML unit (whose
+    # HF `special` flag is false but Recipe correctly treats it as special).
+    added = {t['content']: t['id'] for t in json.loads(PATH.read_text())['added_tokens']}
+    pattern = '(' + '|'.join(re.escape(s) for s in sorted(added, key=len, reverse=True)) + ')'
+    return [i for part in re.split(pattern, text) if part
+            for i in ([added[part]] if part in added else tok.encode(part))]
+
+
+def row_value(row):
+    rev, frontier, chunks, calls, done, block_done = row
+    return rev, frontier, [c.to_json() for c in chunks], calls, done, block_done
+
+
+def response():
+    return d.ChatCompletionResponse('response', 'model', 0, 0, 0)
+
+
+def append(resp, chunks):
+    for chunk in chunks:
+        resp.accumulate(chunk)
+
+
+def test_repeat_divergent_prefixes_and_official_accumulation():
+    tok, converted, generator, session = setup()
+    text = PREFIX + 'Tokyo🤭' + END + '<｜DSML｜invoke name="g"></｜DSML｜invoke></｜DSML｜tool_calls>'
+    ids = encode(tok, text)
+    before = session.status
+    projected = session.preview_tokens(ids)
+    rejected = session.preview_tokens(encode(tok, '<｜DSML｜tool_calls><｜DSML｜invoke name="reject"></｜DSML｜invoke>'))
+    assert any(r[3] for r in rejected[3])
+    assert [row_value(r) for r in projected[3]] == [row_value(r) for r in session.preview_tokens(ids)[3]]
+    assert session.status == before
+    assert projected[:3] == (0, 0, ids)
+    actual_response, predicted_response = response(), response()
+    completions = []
+    for n, token in enumerate(ids):
+        single = session.preview_tokens([token])
+        assert single[:3] == (n, n, [token])
+        actual = session.push(d.InferenceChunk.tokens([token]))
+        assert row_value(actual) == row_value(single[3][0]) == row_value(projected[3][n])
+        assert actual[:2] == (n + 1, n + 1)
+        completions.extend((n + 1, c) for c in actual[3])
+        append(actual_response, actual[2])
+        append(predicted_response, projected[3][n][2])
+        assert actual_response.to_json() == predicted_response.to_json()
+    assert len(completions) == 2
+    assert not any(r[5] for r in projected[3][:-1])
+    assert projected[3][-1][5]
+    assert all(not r[4] for r in projected[3])
+    # Official argument completion precedes the closing invoke suffix and full
+    # block. It must never stand in for a generation-terminal observation.
+    assert all(not projected[3][n - 1][5] for n, _ in completions)
+    assert completions[0][1] == (0, len((PREFIX + 'Tokyo🤭' + END[:-len('invoke>')]).encode()))
+    assert not session.status[2]
+    stop = d.InferenceChunk.finish(d.InferenceFinishReason.Stop)
+    preview_stop = session.preview_tokens([], finish=stop)[3][0]
+    canonical_stop = session.push(stop)
+    assert row_value(preview_stop) == row_value(canonical_stop)
+    append(actual_response, canonical_stop[2])
+    body = json.loads(actual_response.to_json())
+    calls = body['choices'][0]['message']['tool_calls']
+    assert [c['function']['arguments'] for c in calls] == ['{"x": "Tokyo🤭"}', '{}']
+    assert all(re.fullmatch(r'call_\d{2}_[A-Za-z0-9]{24}', c['id']) for c in calls)
+    assert len({c['id'] for c in calls}) == 2
+    assert body['choices'][0]['finish_reason'] == 'tool_calls'
+
+    # Ordinary official 0.2 StreamProcessor, equivalent input. Requests have
+    # independently random IDs/timestamps; compare after only those removals.
+    ordinary = d.StreamProcessor(generator(), converted.parsing_options, tok)
+    official_response = response()
+    for token in ids:
+        append(official_response, ordinary.push(d.InferenceChunk.tokens([token])))
+    append(official_response, ordinary.push(stop))
+    official = json.loads(official_response.to_json())
+    for value in (body, official):
+        value.pop('created')
+        for call in value['choices'][0]['message']['tool_calls']:
+            call.pop('id')
+    assert body == official
+    ordinary.close()
+    session.close()
+    assert session.status[3]
+
+
+@pytest.mark.parametrize('special', [False, True])
+def test_markers_incomplete_arguments_and_candidate_eof(special):
+    tok, _, _, session = setup()
+    text = PREFIX + 'partial'
+    ids = encode(tok, text) if special else [i for c in text for i in tok.encode(c)]
+    for token in ids:
+        assert not session.push(d.InferenceChunk.tokens([token]))[3]
+    before = session.status
+    assert not any(r[3] for r in session.preview_tokens(encode(tok, '{}'))[3])
+    assert not any(r[3] for r in session.preview_tokens(encode(tok, '</｜DSML｜parameter></'))[3])
+    assert not any(r[3] for r in session.preview_tokens([], eof=True)[3])
+    stop = d.InferenceChunk.finish(d.InferenceFinishReason.Stop)
+    isolated_stop = session.preview_tokens([], finish=stop)
+    assert not any(r[3] for r in isolated_stop[3])
+    assert isolated_stop[3][-1][4]
+    assert [row_value(r) for r in isolated_stop[3]] == [
+        row_value(r) for r in session.preview_tokens([], finish=stop)[3]]
+    closing = session.preview_tokens(encode(tok, END))
+    assert sum(len(r[3]) for r in closing[3]) == int(special)
+    assert not any(r[5] for r in closing[3])
+    assert session.status == before
+    session.close()
+
+
+def test_utf8_failed_preview_finish_and_cleanup():
+    tok, _, _, session = setup(['halt'])
+    emoji = tok.encode('🤭')
+    assert len(emoji) > 1
+    assert not session.push(d.InferenceChunk.tokens(emoji[:1]))[2]
+    before = session.status
+    baseline = [row_value(r) for r in session.preview_tokens(emoji[1:], eof=True)[3]]
+    # A native stop token ends the fork; trailing candidates must fail closed.
+    terminal = tok.encode('halt')
+    with pytest.raises(RuntimeError):
+        session.preview_tokens(terminal + tok.encode('after'))
+    assert session.status == before
+    with pytest.raises(TypeError):
+        session.preview_tokens([], finish=d.InferenceChunk.text('bad', 1))
+    assert session.status == before
+    projected = session.preview_tokens(emoji[1:], eof=True)
+    assert [row_value(r) for r in projected[3]] == baseline
+    for i, token in enumerate(emoji[1:]):
+        assert row_value(session.push(d.InferenceChunk.tokens([token]))) == row_value(projected[3][i])
+    assert row_value(session.finish()) == row_value(projected[3][-1])
+    assert session.status[2:4] == (True, False)
+    with pytest.raises(RuntimeError):
+        session.preview_tokens([])
+    session.close()
+    session.close()
+    with pytest.raises(RuntimeError):
+        session.finish()
+    # Core errors release canonical state. Rejected API misuse doesn't consume.
+    _, _, generator, other = setup()
+    with pytest.raises(TypeError):
+        other.push(d.InferenceChunk.tokens([1, 2]))
+    assert other.status == (0, 0, False, False)
+    with pytest.raises(RuntimeError):
+        other.push(d.InferenceChunk.tokens([1], logprobs=[]))
+    assert other.status[3]
+    # Generator ownership is transferred, not copied; GC releases live sessions.
+    g = generator()
+    _, converted, _, _ = setup()
+    s = d.ChatCompletionSemanticSession(g, converted.parsing_options, tok)
+    with pytest.raises(RuntimeError):
+        d.ChatCompletionSemanticSession(g, converted.parsing_options, tok)
+    del s
+    gc.collect()
