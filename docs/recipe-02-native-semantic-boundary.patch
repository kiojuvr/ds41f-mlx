+impl<G: ChunkGenerator + Clone> SemanticState<G> {
+    /// Run candidates on an isolated fork. The generator must be clone-local
+    /// and side-effect-free (as the Chat Completions generator is); Clone alone
+    /// cannot enforce this for third-party generators. No EOF is implied.
+    pub async fn preview(
+        &self,
+        chunks: impl IntoIterator<Item = InferenceChunk>,
+    ) -> Result<(Vec<G::Chunk>, Vec<CompletedCall>), StreamError> {
+        let mut fork = self.clone();
+        let mut output = Vec::new();
+        let first = fork.completed_calls().len();
+        for chunk in chunks {
+            output.extend(fork.consume(chunk).await?);
         }
+        Ok((output, fork.completed_calls()[first..].to_vec()))
     }
