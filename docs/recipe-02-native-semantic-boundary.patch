diff --git a/deepseek-recipe/src/stream/native_boundary_tests.rs b/deepseek-recipe/src/stream/native_boundary_tests.rs
new file mode 100644
index 0000000..aa95cd7
--- /dev/null
+++ b/deepseek-recipe/src/stream/native_boundary_tests.rs
@@ -0,0 +1,267 @@
+//! Focused executable proof of the Recipe 0.2 consuming snapshot boundary.
+mod messages;
+use super::*;
+use crate::protocol::openai::chat_completion::response::{
+    ChatCompletionChunkGenerator, ChatCompletionResponse,
+};
+use crate::response::{Accumulate, ProtocolResponse};
+use tokenizers::Tokenizer;
+
+fn tokenizer() -> &'static Tokenizer {
+    static TOKENIZER: std::sync::OnceLock<Tokenizer> = std::sync::OnceLock::new();
+    TOKENIZER.get_or_init(|| {
+        Tokenizer::from_file(concat!(
+            env!("CARGO_MANIFEST_DIR"),
+            "/../static/tokenizers/v41/tokenizer.json"
+        ))
+        .unwrap()
+    })
+}
+
+fn state(thinking: bool) -> SemanticState<ChatCompletionChunkGenerator> {
+    StreamProcessor::new(
+        ChatCompletionChunkGenerator::new("response".into(), "model".into(), true, thinking),
+        ParsingOptions {
+            thinking_initial_stage: thinking.then_some(ThinkingInitialStage::ReasoningStart),
+            ..Default::default()
+        },
+    )
+    .with_tokenizer(tokenizer().clone())
+    .into_state()
+}
+
+fn tokens(ids: &[u32]) -> InferenceChunk {
+    InferenceChunk::Tokens {
+        token_ids: ids.to_vec(),
+        logprobs: None,
+    }
+}
+
+fn encode(text: &str) -> Vec<u32> {
+    tokenizer().encode(text, false).unwrap().get_ids().to_vec()
+}
+
+fn json(value: &impl serde::Serialize) -> serde_json::Value {
+    serde_json::to_value(value).unwrap()
+}
+
+fn response() -> ChatCompletionResponse {
+    ChatCompletionResponse::new("response".into(), "model".into(), 0, 0, 0)
+}
+
+const PREFIX: &str =
+    "<｜DSML｜tool_calls><｜DSML｜invoke name=\"f\"><｜DSML｜parameter name=\"x\" string=\"true\">";
+const END: &str = "</｜DSML｜parameter></｜DSML｜invoke>";
+
+#[tokio::test]
+async fn native_boundary_repeated_preview_exact_prefix_response_and_completion() {
+    let text = format!(
+        "</think>{PREFIX}Tokyo🤭{END}<｜DSML｜invoke name=\"g\"></｜DSML｜invoke></｜DSML｜tool_calls>"
+    );
+    let ids = encode(&text);
+    let mut canonical = state(true);
+    // Full candidate repeated before any canonical consumption draws no global IDs.
+    let full = canonical
+        .preview(ids.iter().map(|id| tokens(&[*id])))
+        .await
+        .unwrap();
+    let rejected = canonical.preview([tokens(&encode(
+        "</think><｜DSML｜tool_calls><｜DSML｜invoke name=\"rejected\"></｜DSML｜invoke></｜DSML｜tool_calls>"
+    ))]).await.unwrap();
+    assert_eq!(rejected.1.len(), 1);
+    let bulk = canonical.preview([tokens(&ids)]).await.unwrap();
+    assert_eq!(bulk.1, full.1);
+    let mut bulk_response = response();
+    for chunk in bulk.0 {
+        bulk_response.accumulate(chunk);
+    }
+    let again = canonical
+        .preview(ids.iter().map(|id| tokens(&[*id])))
+        .await
+        .unwrap();
+    assert_eq!(json(&full.0), json(&again.0));
+    assert_eq!(full.1, again.1);
+    assert_eq!(full.1.len(), 2);
+    // Official 0.2 ends arguments at the closing </ + DSML token, before
+    // reading the literal `invoke>` suffix; certify that action exactly.
+    assert_eq!(
+        full.1[0].source_end,
+        text.find(END).unwrap() + END.len() - "invoke>".len()
+    );
+    assert_eq!(
+        full.1[1].source_end,
+        text.rfind("</｜DSML｜invoke>").unwrap() + "</｜DSML｜".len()
+    );
+    assert!(canonical.completed_calls().is_empty());
+
+    let mut projected_response = response();
+    let mut canonical_response = response();
+    let mut emitted = Vec::new();
+    for id in ids {
+        let before = canonical.completed_calls().to_vec();
+        let (projected, completions) = canonical.preview([tokens(&[id])]).await.unwrap();
+        let repeated = canonical.preview([tokens(&[id])]).await.unwrap();
+        assert_eq!(json(&projected), json(&repeated.0));
+        assert_eq!(completions, repeated.1);
+        assert_eq!(canonical.completed_calls(), before);
+        // A divergent named call/EOF on a fork must not affect canonical identity,
+        // response, pending markers, or subsequent completion.
+        let _ = canonical.preview([
+            tokens(&encode("divergent</｜DSML｜parameter></｜DSML｜invoke><｜DSML｜invoke name=\"rejected\"></｜DSML｜invoke>")),
+            InferenceChunk::Finish { finish_reason: InferenceFinishReason::Stop },
+        ]).await.unwrap();
+        let actual = canonical.consume(tokens(&[id])).await.unwrap();
+        assert_eq!(json(&projected), json(&actual));
+        assert_eq!(&canonical.completed_calls()[before.len()..], completions);
+        for chunk in projected {
+            projected_response.accumulate(chunk);
+        }
+        for chunk in actual {
+            emitted.push(json(&chunk));
+            canonical_response.accumulate(chunk);
+        }
+        assert_eq!(json(&projected_response), json(&canonical_response));
+    }
+    assert_eq!(json(&emitted), json(&full.0));
+    assert_eq!(json(&projected_response), json(&canonical_response));
+    assert_eq!(json(&bulk_response), json(&canonical_response));
+    let calls = canonical_response.choices[0]
+        .message
+        .tool_calls
+        .as_ref()
+        .unwrap();
+    assert_eq!(calls.len(), 2);
+    assert_eq!(calls[0].call.function.arguments, "{\"x\": \"Tokyo🤭\"}");
+    assert_eq!(calls[1].call.function.arguments, "{}");
+    assert_ne!(calls[0].call.id, calls[1].call.id);
+    for (index, call) in calls.iter().enumerate() {
+        let id = &call.call.id;
+        assert_eq!(id.len(), 35);
+        assert!(id.starts_with(&format!("call_{index:02}_ET_")));
+        assert!(id[11..31].bytes().all(|b| b.is_ascii_alphanumeric()));
+        let input = id[..31].replace('_', "");
+        assert_eq!(
+            &id[31..],
+            format!(
+                "{:04}",
+                xxhash_rust::xxh3::xxh3_64(input.as_bytes()) % 10000
+            )
+        );
+    }
+    assert!(
+        !canonical.is_finished(),
+        "call completion is not assistant-turn EOF"
+    );
+}
+
+#[tokio::test]
+async fn native_boundary_partial_arguments_and_rejected_closure() {
+    let mut canonical = state(false);
+    canonical
+        .consume(tokens(&encode(&format!("{PREFIX}partial"))))
+        .await
+        .unwrap();
+    assert!(
+        canonical.completed_calls().is_empty(),
+        "a named tool is not completed"
+    );
+    // A valid-looking JSON value and a partial special-token marker do not
+    // complete an invoke.
+    assert!(
+        canonical
+            .preview([tokens(&encode("{}"))])
+            .await
+            .unwrap()
+            .1
+            .is_empty()
+    );
+    let partial = encode("</｜DSML｜parameter></");
+    assert!(
+        canonical
+            .preview([tokens(&partial)])
+            .await
+            .unwrap()
+            .1
+            .is_empty()
+    );
+    let done = canonical.preview([tokens(&encode(END))]).await.unwrap();
+    assert_eq!(done.1.len(), 1);
+    assert!(canonical.completed_calls().is_empty());
+    // Reject that completed projection and choose a different argument suffix.
+    canonical
+        .consume(tokens(&encode(" alternative")))
+        .await
+        .unwrap();
+    assert!(canonical.completed_calls().is_empty());
+    let fork = canonical.clone();
+    assert_eq!(
+        canonical
+            .preview([tokens(&encode(END))])
+            .await
+            .unwrap()
+            .1
+            .len(),
+        1
+    );
+    // Even a consuming EOF on a fork must not synthesize argument-end.
+    let mut eof_fork = fork;
+    eof_fork.finish().await;
+    assert!(eof_fork.completed_calls().is_empty());
+    canonical.consume(tokens(&encode(END))).await.unwrap();
+    assert_eq!(canonical.completed_calls().len(), 1);
+}
+
+#[tokio::test]
+async fn native_boundary_plain_markers_utf8_and_failed_preview() {
+    let tok = tokenizer();
+    let text = format!("{PREFIX}value{END}</｜DSML｜tool_calls>");
+    // Separately encode each character: all DSML spellings are ordinary tokens.
+    let plain: Vec<u32> = text
+        .chars()
+        .flat_map(|c| tok.encode(c.to_string(), false).unwrap().get_ids().to_vec())
+        .collect();
+    let mut canonical = state(false);
+    let ordinary = canonical
+        .preview(plain.iter().map(|id| tokens(&[*id])))
+        .await
+        .unwrap();
+    assert!(ordinary.1.is_empty());
+    assert!(!json(&ordinary.0).to_string().contains("call_00_"));
+    // A rejected invalid logprob chunk must not poison the live decoder.
+    assert!(
+        canonical
+            .preview([InferenceChunk::Tokens {
+                token_ids: vec![1],
+                logprobs: Some(vec![]),
+            }])
+            .await
+            .is_err()
+    );
+    assert!(!canonical.is_finished());
+    // Split the real UTF-8 bytes of an emoji over tokens, previewing while the
+    // official decoder has buffered an incomplete sequence.
+    let emoji = encode("🤭");
+    assert!(emoji.len() > 1);
+    for id in &emoji[..emoji.len() - 1] {
+        let p = canonical.preview([tokens(&[*id])]).await.unwrap();
+        let a = canonical.consume(tokens(&[*id])).await.unwrap();
+        assert_eq!(json(&p.0), json(&a));
+    }
+    let rest = [emoji[emoji.len() - 1]];
+    let p = canonical.preview([tokens(&rest)]).await.unwrap();
+    assert_eq!(
+        json(&p.0),
+        json(&canonical.consume(tokens(&rest)).await.unwrap())
+    );
+    assert!(json(&p.0).to_string().contains('🤭'));
+    // Also fork with incomplete UTF-8 immediately before a special token: the
+    // official forced U+FFFD flush must be identical, without touching live state.
+    let mut fragmented = state(true);
+    fragmented.consume(tokens(&emoji[..1])).await.unwrap();
+    let special = encode("</think>");
+    let p = fragmented.preview([tokens(&special)]).await.unwrap();
+    assert_eq!(
+        json(&p.0),
+        json(&fragmented.consume(tokens(&special)).await.unwrap())
+    );
+}
