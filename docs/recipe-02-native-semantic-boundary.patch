@@ -0,0 +1,149 @@
+//! Same engine and official Messages events; no protocol identity exemption.
+use super::*;
+use crate::protocol::anthropic::messages::response::{MessagesChunkGenerator, MessagesResponse};
+use tokio_stream::StreamExt;
+
+fn copy_input(input: &InferenceChunk) -> InferenceChunk {
+    match input {
+        InferenceChunk::Ready {
+            prompt_usage,
+            system_fingerprint,
+        } => InferenceChunk::Ready {
+            prompt_usage: *prompt_usage,
+            system_fingerprint: system_fingerprint.clone(),
+        },
+        InferenceChunk::Tokens {
+            token_ids,
+            logprobs: None,
+        } => tokens(token_ids),
+        InferenceChunk::Finish { finish_reason } => InferenceChunk::Finish {
+            finish_reason: *finish_reason,
+        },
+        _ => unreachable!("only the test's Ready/token/Finish inputs"),
+    }
+}
+
+#[tokio::test]
+async fn native_boundary_messages_exact_standard_stream_and_checksum() {
+    for reasoning in ["", "inspect carefully"] {
+        for ending in [
+            None,
+            Some(InferenceFinishReason::Stop),
+            Some(InferenceFinishReason::Length),
+        ] {
+            let generator = MessagesChunkGenerator::new("response", "model", true)
+                .with_signature("opaque-signature");
+            let options = ParsingOptions {
+                thinking_initial_stage: Some(ThinkingInitialStage::ReasoningStart),
+                ..Default::default()
+            };
+            // A clone is this request's fork, not an independently seeded request.
+            let mut canonical = StreamProcessor::new(generator.clone(), options.clone())
+                .with_tokenizer(tokenizer().clone())
+                .into_state();
+            let processor =
+                StreamProcessor::new(generator, options).with_tokenizer(tokenizer().clone());
+            let ids = encode(&format!(
+                "{reasoning}</think>intro {PREFIX}Tokyo🤭{END}<｜DSML｜invoke name=\"g\"></｜DSML｜invoke></｜DSML｜tool_calls>"
+            ));
+            let ready = InferenceChunk::Ready {
+                prompt_usage: PromptUsage {
+                    prompt_tokens: 20,
+                    prompt_cache_hit_tokens: 7,
+                },
+                system_fingerprint: None,
+            };
+            let mut inputs = vec![ready];
+            inputs.extend(ids.iter().map(|id| tokens(&[*id])));
+            if let Some(reason) = ending {
+                inputs.push(InferenceChunk::Finish {
+                    finish_reason: reason,
+                });
+            }
+            let official_inputs = inputs.iter().map(copy_input).collect::<Vec<_>>();
+            let stream = processor.into_protocol_stream(tokio_stream::iter(official_inputs));
+            tokio::pin!(stream);
+            let official: Vec<_> = stream.collect::<Result<Vec<_>, _>>().await.unwrap();
+            let mut actual = Vec::new();
+            let mut accumulated = MessagesResponse::new("response".into(), "model".into(), 0, 0, 0);
+            let mut predicted = accumulated.clone();
+            for input in inputs {
+                let preview = canonical.preview([copy_input(&input)]).await.unwrap();
+                assert_eq!(
+                    json(&preview.0),
+                    json(&canonical.preview([copy_input(&input)]).await.unwrap().0)
+                );
+                // Reject an error and a complete divergent tool candidate.
+                assert!(
+                    canonical
+                        .preview([InferenceChunk::Tokens {
+                            token_ids: vec![1],
+                            logprobs: Some(vec![])
+                        }])
+                        .await
+                        .is_err()
+                );
+                let _ = canonical.preview([tokens(&encode("</think><｜DSML｜tool_calls><｜DSML｜invoke name=\"reject\"></｜DSML｜invoke>"))]).await.unwrap();
+                let chunks = canonical.consume(input).await.unwrap();
+                assert_eq!(json(&preview.0), json(&chunks));
+                for chunk in preview.0 {
+                    predicted.accumulate(chunk);
+                }
+                for chunk in chunks {
+                    accumulated.accumulate(chunk.clone());
+                    actual.push(chunk);
+                }
+                assert_eq!(json(&accumulated), json(&predicted));
+            }
+            if ending.is_none() {
+                let mut fork = canonical.clone();
+                let preview = fork.finish().await;
+                let eof = canonical.finish().await;
+                assert_eq!(json(&preview), json(&eof));
+                for chunk in eof {
+                    accumulated.accumulate(chunk.clone());
+                    actual.push(chunk);
+                }
+            }
+            // Exact full events and accumulated responses, IDs/signatures included.
+            assert_eq!(json(&actual), json(&official));
+            let mut standard = MessagesResponse::new("response".into(), "model".into(), 0, 0, 0);
+            for chunk in official {
+                standard.accumulate(chunk);
+            }
+            assert_eq!(json(&accumulated), json(&standard));
+            assert_eq!(canonical.completed_calls().len(), 2);
+            assert!(canonical.is_finished());
+            // The tool-block bit is a live-parser observation, not sticky state.
+            assert!(!canonical.tool_block_finished());
+            let body = json(&accumulated);
+            let tools: Vec<_> = body["content"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .filter(|b| b["type"] == "tool_use")
+                .collect();
+            for (index, tool) in tools.iter().enumerate() {
+                let id = tool["id"].as_str().unwrap();
+                let mark = if reasoning.is_empty() { "ET_" } else { "" };
+                let prefix = format!("call_{index:02}_{mark}");
+                assert!(id.starts_with(&prefix));
+                assert_eq!(id.len(), prefix.len() + 24);
+                assert!(
+                    id[prefix.len()..id.len() - 4]
+                        .bytes()
+                        .all(|b| b.is_ascii_alphanumeric())
+                );
+                assert_eq!(
+                    &id[id.len() - 4..],
+                    format!(
+                        "{:04}",
+                        xxhash_rust::xxh3::xxh3_64(id[..id.len() - 4].replace('_', "").as_bytes())
+                            % 10000
+                    )
+                );
+            }
+            assert_eq!(body["content"][0]["signature"], "opaque-signature");
+        }
+    }
+}
