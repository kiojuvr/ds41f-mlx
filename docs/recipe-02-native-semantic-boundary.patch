new file mode 100644
index 0000000..59700ae
--- /dev/null
+++ b/deepseek-recipe-python/src/response/semantic.rs
@@ -0,0 +1,223 @@
+use super::*;
+
+// Each row is one actual input operation, never a text-offset token estimate.
+type SemanticRow = (u64, u64, Vec<Py<PyAny>>, Vec<(usize, usize)>, bool, bool);
+type SemanticPreview = (u64, u64, Vec<u32>, Vec<SemanticRow>);
+
+// Only the official, request-local generators are admitted here. Clone alone
+// does not guarantee speculative safety for externally effectful generators.
+trait SemanticGenerator: ChunkGenerator + Clone {
+    fn protocol_chunk(chunk: Self::Chunk) -> ProtocolChunk;
+}
+
+impl SemanticGenerator for ChatCompletionChunkGenerator {
+    fn protocol_chunk(chunk: Self::Chunk) -> ProtocolChunk {
+        ProtocolChunk::ChatCompletion(chunk)
+    }
+}
+
+impl SemanticGenerator for MessagesChunkGenerator {
+    fn protocol_chunk(chunk: Self::Chunk) -> ProtocolChunk {
+        ProtocolChunk::Messages(chunk)
+    }
+}
+
+#[derive(Clone)]
+struct SemanticOwner<G: SemanticGenerator> {
+    core: Option<deepseek_recipe::stream::SemanticState<G>>,
+    revision: u64,
+    frontier: u64,
+}
+
+impl<G: SemanticGenerator> SemanticOwner<G> {
+    fn live(&self) -> PyResult<()> {
+        match &self.core {
+            Some(core) if !core.is_finished() => Ok(()),
+            _ => Err(PyRuntimeError::new_err(
+                "semantic session is closed or finished",
+            )),
+        }
+    }
+
+    fn step(
+        &mut self,
+        chunk: Option<InferenceChunk>,
+    ) -> PyResult<(Vec<G::Chunk>, Vec<(usize, usize)>, bool)> {
+        self.live()?;
+        let core = self.core.as_mut().unwrap();
+        let first = core.completed_calls().len();
+        let token = matches!(&chunk, Some(InferenceChunk::Tokens { .. }));
+        let output = match chunk {
+            Some(chunk) => match block_on(core.consume(chunk)) {
+                Ok(output) => output,
+                Err(error) => {
+                    self.core = None;
+                    return Err(PyRuntimeError::new_err(error.to_string()));
+                }
+            },
+            None => block_on(core.finish()),
+        };
+        self.revision += 1;
+        self.frontier += u64::from(token);
+        let calls = core.completed_calls()[first..]
+            .iter()
+            .map(|c| (c.index, c.source_end))
+            .collect();
+        Ok((output, calls, core.is_finished()))
+    }
+
+    fn row(&mut self, py: Python<'_>, chunk: Option<InferenceChunk>) -> PyResult<SemanticRow> {
+        let (chunks, calls, finished) = self.step(chunk)?;
+        let chunks = chunks
+            .into_iter()
+            .map(|c| G::protocol_chunk(c).into_python(py))
+            .collect::<PyResult<_>>()?;
+        let tool_block_finished = self.core.as_ref().is_some_and(|c| c.tool_block_finished());
+        Ok((
+            self.revision,
+            self.frontier,
+            chunks,
+            calls,
+            finished,
+            tool_block_finished,
+        ))
+    }
+}
+
+// Both protocols use exactly the same lifecycle, frontier and preview rules.
+macro_rules! semantic_session {
+    ($session:ident, $name:literal, $generator:ident, $core:ty) => {
+        /// One request's official consuming pipeline. No history replay.
+        #[pyclass(name = $name, module = "deepseek_recipe._native", frozen)]
+        pub(crate) struct $session {
+            owner: Mutex<SemanticOwner<$core>>,
+        }
+
+        #[pymethods]
+        impl $session {
+            #[new]
+            fn new(
+                generator: &mut $generator,
+                options: &PyParsingOptions,
+                tokenizer: &PyTokenizer,
+            ) -> PyResult<Self> {
+                let core = StreamProcessor::new(
+                    take_generator(&mut generator.inner)?,
+                    options.inner.clone(),
+                )
+                .with_tokenizer(tokenizer.inner.clone())
+                .into_state();
+                Ok(Self {
+                    owner: Mutex::new(SemanticOwner {
+                        core: Some(core),
+                        revision: 0,
+                        frontier: 0,
+                    }),
+                })
+            }
+
+            /// Consume Ready, exactly one token (with optional logprobs), or backend Finish.
+            /// Returns (revision, token_frontier, native_chunks, new_completed_calls, finished, tool_block_finished).
+            /// Completed calls are (index, absolute decoded source byte endpoint), NOT tool authority.
+            fn push(&self, py: Python<'_>, chunk: &PyInferenceChunk) -> PyResult<SemanticRow> {
+                let chunk = chunk.to_core();
+                match &chunk {
+                    InferenceChunk::Tokens { token_ids, .. } if token_ids.len() == 1 => (),
+                    InferenceChunk::Ready { .. } | InferenceChunk::Finish { .. } => (),
+                    _ => return Err(PyTypeError::new_err("expected Ready, one token, or Finish")),
+                }
+                self.owner
+                    .lock()
+                    .map_err(|_| PyRuntimeError::new_err("semantic lock poisoned"))?
+                    .row(py, Some(chunk))
+            }
+
+            /// Fork once, feed candidates one token per row, optionally Finish or EOF.
+            /// Returns (base_revision, base_frontier, exact_candidate_ids, rows).
+            /// No implicit EOF. A terminal row before remaining tokens raises; no live mutation.
+            #[pyo3(signature = (token_ids, *, finish = None, eof = false))]
+            fn preview_tokens(
+                &self,
+                py: Python<'_>,
+                token_ids: Vec<u32>,
+                finish: Option<&PyInferenceChunk>,
+                eof: bool,
+            ) -> PyResult<SemanticPreview> {
+                let finish = finish.map(PyInferenceChunk::to_core);
+                if (finish.is_some() && eof)
+                    || finish
+                        .as_ref()
+                        .is_some_and(|c| !matches!(c, InferenceChunk::Finish { .. }))
+                {
+                    return Err(PyTypeError::new_err("choose backend Finish or EOF"));
+                }
+                let mut fork = self
+                    .owner
+                    .lock()
+                    .map_err(|_| PyRuntimeError::new_err("semantic lock poisoned"))?
+                    .clone();
+                fork.live()?;
+                let (revision, frontier) = (fork.revision, fork.frontier);
+                let mut rows = Vec::new();
+                for id in &token_ids {
+                    rows.push(fork.row(
+                        py,
+                        Some(InferenceChunk::Tokens {
+                            token_ids: vec![*id],
+                            logprobs: None,
+                        }),
+                    )?);
+                }
+                if finish.is_some() || eof {
+                    rows.push(fork.row(py, finish)?);
+                }
+                Ok((revision, frontier, token_ids, rows))
+            }
+
+            /// Explicit canonical EOF; does not invent a backend Stop.
+            fn finish(&self, py: Python<'_>) -> PyResult<SemanticRow> {
+                self.owner
+                    .lock()
+                    .map_err(|_| PyRuntimeError::new_err("semantic lock poisoned"))?
+                    .row(py, None)
+            }
+
+            /// (revision, token_frontier, finished, closed). Close is not successful EOF.
+            #[getter]
+            fn status(&self) -> PyResult<(u64, u64, bool, bool)> {
+                let owner = self
+                    .owner
+                    .lock()
+                    .map_err(|_| PyRuntimeError::new_err("semantic lock poisoned"))?;
+                Ok((
+                    owner.revision,
+                    owner.frontier,
+                    owner.core.as_ref().is_some_and(|c| c.is_finished()),
+                    owner.core.is_none(),
+                ))
+            }
+
+            /// Idempotent release without protocol output; also released by Python GC.
+            fn close(&self) -> PyResult<()> {
+                self.owner
+                    .lock()
+                    .map_err(|_| PyRuntimeError::new_err("semantic lock poisoned"))?
+                    .core = None;
+                Ok(())
+            }
+        }
+    };
+}
+
+semantic_session!(
+    PyChatCompletionSemanticSession,
+    "ChatCompletionSemanticSession",
+    PyChatCompletionChunkGenerator,
+    ChatCompletionChunkGenerator
+);
+semantic_session!(
+    PyMessagesSemanticSession,
+    "MessagesSemanticSession",
+    PyMessagesChunkGenerator,
+    MessagesChunkGenerator
+);
